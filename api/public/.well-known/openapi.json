  "paths": {
    "/v1/tools/web-scrape": {
      "post": {
        "operationId": "webScrape",
        "summary": "Scrape any public URL with optional CSS selector",
        "tags": [
          "Web"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "URL to scrape"
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "markdown",
                      "html",
                      "text"
                    ],
                    "default": "markdown"
                  },
                  "selector": {
                    "type": "string",
                    "description": "CSS selector to extract specific element"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scraped content"
          }
        }
      }
    },
    "/v1/tools/extract-page": {
