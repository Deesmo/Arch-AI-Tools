{
  "openapi": "3.1.0",
  "info": {
    "title": "Arch Tools API (GPT Actions)",
    "version": "1.8.0",
    "description": "Top 30 tools from Arch Tools \u2014 web scraping, AI generation, crypto data, NLP, research, and more. Full API at https://archtools.dev"
  },
  "servers": [
    {
      "url": "https://archtools.dev"
    }
