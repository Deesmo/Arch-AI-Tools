{
  "info": {
    "name": "Arch Tools API",
    "_postman_id": "00000000-0000-0000-0000-000000000000",
    "description": "Premium Postman collection for Arch Tools (archtools.dev). Includes auth, tools, payments, and legal endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://archtools.dev"
    },
    {
      "key": "apiKey",
      "value": "REPLACE_WITH_API_KEY"
    }
  ],
  "item": [
    {
      "name": "Health & Status",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "Status (v1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "status"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Agent",
      "item": [
        {
          "name": "Register (v1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Brad\",\n  \"email\": \"brad@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/agent/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "agent",
                "register"
              ]
            }
          }
        },
        {
          "name": "Usage (v1)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/agent/usage",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "agent",
                "usage"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Tools",
      "item": [
        {
          "name": "List Tools (v1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/tools",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tools"
              ]
            }
          }
        },
        {
          "name": "Invoke web-scrape (v1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com\",\n  \"extract\": {\n    \"title\": true,\n    \"links\": false\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/tools/web-scrape",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tools",
                "web-scrape"
              ]
            }
          }
        },
        {
          "name": "Invoke validate-data (v1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"email\": \"test@example.com\"\n  },\n  \"rules\": {\n    \"email\": \"email\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/tools/validate-data",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tools",
                "validate-data"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create Checkout (v1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pack\": \"pro\",\n  \"success_url\": \"https://archtools.dev/success\",\n  \"cancel_url\": \"https://archtools.dev\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "checkout"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Legal",
      "item": [
        {
          "name": "Legal Index",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/legal",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "legal"
              ]
            }
          }
        },
        {
          "name": "Terms",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/legal/terms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "legal",
                "terms"
              ]
            }
          }
        },
        {
          "name": "Privacy",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/legal/privacy",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "legal",
                "privacy"
              ]
            }
          }
        }
      ]
    }
  ]
}