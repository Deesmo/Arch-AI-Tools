# Server
PORT=8787
NODE_ENV=production
CORS_ORIGIN=https://archtools.dev

# Public base URL (used for discovery/OpenAPI links). Set to your canonical API origin.
PUBLIC_API_BASE_URL=https://archtools.dev
PUBLIC_SITE_URL=https://archtools.dev

# Database (Render Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require

# Redis — required for x402 nonce deduplication (replay attack prevention)
# Without this, x402 payments will work but replay protection is disabled.
REDIS_URL=redis://USER:PASSWORD@HOST:PORT

# Admin key (for publishing tools, plan upgrades)
ADMIN_KEY=change-me-long-random-string

# Rate limiting (requests per minute per agent)
RATE_LIMIT_FREE=60
RATE_LIMIT_PRO=240
RATE_LIMIT_BUSINESS=1200

# Default free credits monthly grant
FREE_MONTHLY_CREDITS=100

# Email (used for magic-link verification)
# Recommended: Resend
RESEND_API_KEY=
# Alternative: Postmark
POSTMARK_SERVER_TOKEN=
# From address (for either provider)
EMAIL_FROM=Arch Tools <no-reply@archtools.dev>

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe price IDs — one-time credit packs
# Create these in the Stripe dashboard as one-time prices
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Stripe price IDs — subscription plans (current default IDs shown as reference)
STRIPE_PRICE_SUB_STARTER_MONTHLY=price_1T8pQtKzBSl1smzF1927svjM
STRIPE_PRICE_SUB_PRO_MONTHLY=price_1T8pQtKzBSl1smzF3Lv6bPEr
STRIPE_PRICE_SUB_BUSINESS_MONTHLY=price_1T8pQuKzBSl1smzF8WWHHAr8
STRIPE_PRICE_SUB_STARTER_ANNUAL=price_1T8pQuKzBSl1smzFRoaBUtBf
STRIPE_PRICE_SUB_PRO_ANNUAL=price_1T8pQuKzBSl1smzFa6rrFn18
STRIPE_PRICE_SUB_BUSINESS_ANNUAL=price_1T8pQvKzBSl1smzFzM34v689

# AI Generate tool (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Error tracking (Sentry — optional but recommended)
SENTRY_DSN=

# Luxury limits / controls
ARCH_KEY_MODE=test
TOOL_TIMEOUT_MS=15000
SCRAPE_MAX_BYTES=750000
SCRAPE_MAX_URL_LEN=2048
SCRAPE_MAX_SELECTOR_LEN=200
SCRAPE_MAX_REDIRECTS=3
AI_TIMEOUT_MS=20000
AI_MAX_PROMPT_CHARS=10000
AI_MAX_SYSTEM_CHARS=2000
AI_MAX_TOKENS=2048
AI_ALLOWED_MODELS=claude-sonnet-4-20250514,claude-3-5-sonnet-20241022,claude-3-5-haiku-20241022

# Real-time web search (Tavily)
TAVILY_API_KEY=


# Optional: protected metrics snapshot
# Set a random string and call GET /v1/metrics with header x-metrics-key
METRICS_API_KEY=

# Admin dashboard / request log viewer (falls back to METRICS_API_KEY if unset)
ADMIN_API_KEY=


# Enterprise logs & rollups
# Raw ApiRequestLog retention (days)
LOG_RETENTION_DAYS=30
# DailyUsageRollup retention (days)
ROLLUP_RETENTION_DAYS=365
# Backfill window for rollups (days) to capture late-arriving logs
ROLLUP_DAYS_BACK=3

# Optional: separate admin key (falls back to METRICS_API_KEY if omitted)
ADMIN_API_KEY=

# Optional: Postgres partitioning for ApiRequestLog (high volume)
ENABLE_PARTITIONING=false
PARTITION_PRECREATE_MONTHS=2

# Admin access
# Option A (recommended): single superadmin key (full scopes)
# ADMIN_API_KEY=...
# Option B: multiple env-backed keys with scopes (JSON array)
# ADMIN_KEYS_JSON='[{"name":"readonly","key":"...","scopes":["logs:read","billing:read","system:read"]}]'
# Option C: DB-backed keys via /v1/admin/keys (requires an authenticated admin with admin:write)
