generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgentPlan {
  free
  pro
  business
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  emailVerifiedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  agents          Agent[]
  verifications   EmailVerification[]

  @@map("users")
}

model EmailVerification {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  email      String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([email])
  @@map("email_verifications")
}

model Agent {
  apiRequests  ApiRequest[]
  id            String   @id @default(cuid())
  name          String
  email         String?  @unique
  userId        String?  @unique
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  plan          AgentPlan @default(free)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  apiKeys       ApiKey[]
  creditGrants  CreditGrant[]
  ledger        LedgerEntry[]

  @@index([email])
}

model ApiKey {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  keyHash     String   @unique
  prefix      String
  label       String?
  createdAt   DateTime @default(now())
  revokedAt   DateTime?

  // Optional key restrictions (enterprise/premium controls)
  allowedOrigins String? // comma-separated exact origins
  allowedIps     String? // comma-separated IPs (exact match)
  dailyCreditCap Int?    // optional per-key daily spend cap

  // Optional scrape controls
  scrapeEnabled      Boolean @default(true)
  allowedScrapeDomains String? // comma-separated domains (suffix match)

  @@index([agentId])
  @@index([prefix])
}

model Tool {
  id          String   @id @default(cuid())
  name        String   @unique
  version     String   @default("1.0.0")
  tags        String[] @default([])
  author      String?
  homepage    String?
  minPlan     AgentPlan? // minimum plan required (optional)
  deprecated  Boolean  @default(false)
  description String
  endpoint    String
  method      String   @default("POST")
  credits     Int
  schemaJson  Json?
  category    String?
  ownerAgentId String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LedgerEntry {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  kind        String   // "debit" or "credit"
  credits     Int
  toolName    String?
  requestId   String?
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([agentId, createdAt])
  @@index([agentId, kind])
}

model CreditGrant {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  credits     Int
  source      String   // "stripe", "promo", "monthly_free"
  reference   String?
  createdAt   DateTime @default(now())

  @@index([agentId, createdAt])
  @@unique([agentId, source, reference])
}

// ─────────────────────────────────────────────────────────────────────────────
// V9 additions: premium dashboard analytics + future marketplace
// ─────────────────────────────────────────────────────────────────────────────

model ApiRequest {
  id           String   @id @default(cuid())
  agentId      String
  agent        Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  tool         String
  status       String   // "ok" | "error"
  creditsUsed  Int
  latencyMs    Int
  requestId    String?
  meta         Json?
  createdAt    DateTime @default(now())

  @@index([agentId, createdAt])
  @@index([tool, createdAt])
  @@map("api_requests")
}

model DeveloperTool {
  id           String   @id @default(cuid())
  developerId  String

  name         String
  description  String
  endpoint     String
  pricePerCall Int
  createdAt    DateTime @default(now())

  @@index([developerId, createdAt])
  @@index([name])
  @@map("developer_tools")
}


model ApiRequestLog {
  id              String   @id @default(cuid())
  createdAt        DateTime @default(now())

  agentId          String?
  apiKeyId         String?
  apiKeyPrefix     String?
  toolName         String?
  endpoint         String?
  method           String?
  status           Int?
  latencyMs        Int?
  creditsUsed      Int?
  creditsRemaining Int?
  requestId        String?
  ip               String?
  userAgent        String?
  errorCode        String?
  errorMessage     String?

  @@index([createdAt])
  @@index([agentId, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([toolName, createdAt])
}


model DailyUsageRollup {
  id              String   @id @default(cuid())
  day             DateTime

  agentId         String?
  apiKeyId        String?
  toolName        String?

  requestCount    Int      @default(0)
  successCount    Int      @default(0)
  errorCount      Int      @default(0)
  creditsUsedSum  Int      @default(0)
  latencyAvgMs    Int      @default(0)
  latencyMaxMs    Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([day, agentId, apiKeyId, toolName])
  @@index([day])
  @@index([agentId, day])
  @@index([apiKeyId, day])
  @@index([toolName, day])
}

model SystemJobRun {
  id             String   @id @default(cuid())
  jobName         String   @unique
  lastRunAt       DateTime?
  lastStatus      String?  // "ok" | "error"
  lastMessage     String?
  lastDurationMs  Int?
  meta            Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([updatedAt])
}

model AdminApiKey {
  id         String   @id @default(cuid())
  name       String
  keyPrefix  String   @unique
  keyHash    String   @unique
  scopes     String[]
  isActive   Boolean  @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive])
  @@index([updatedAt])
  @@map("admin_api_keys")
}
