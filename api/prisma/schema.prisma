// This is your Prisma schema file

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agent {
  id           String       @id @default(cuid())
  apiKey       String       @unique @map("api_key")
  apiKeyPrefix String?      @map("api_key_prefix") @db.VarChar(12)  // first 12 chars — lookup index
  apiKeyHash   String?      @map("api_key_hash")                     // bcrypt hash for secure comparison
  email        String       @unique
  name         String?
  passwordHash      String?      @map("password_hash")
  resetToken        String?      @map("reset_token")
  resetTokenExpiry  DateTime?    @map("reset_token_expiry")
  credits      Int          @default(0)
  tier         String       @default("free")
  totalCalls   Int          @default(0)
  lastSeenAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // ─── Agent Identity (KYA — Know Your Agent) ──────────────────────────────
  description     String?                          // what this agent does
  walletAddress   String?      @map("wallet_address")  // primary wallet for x402 payments
  callbackUrl     String?      @map("callback_url")    // webhook for async notifications
  reputationScore Int          @default(50) @map("reputation_score")  // 0-100
  badge           String       @default("none")    // none | bronze | silver | gold | diamond
  errorCount      Int          @default(0) @map("error_count")
  successCount    Int          @default(0) @map("success_count")
  totalSpentUsdc  Float        @default(0) @map("total_spent_usdc")
  isPublic        Boolean      @default(true) @map("is_public")  // show on leaderboard/profile

  // back-references — required for Prisma v5 relations
  apiRequests  ApiRequest[]
  purchases    Purchase[]
}

enum ToolPlan {
  free
  starter
  pro
  business
}

model Tool {
  id           String    @id @default(cuid())
  name         String    @unique
  description  String
  endpoint     String
  method       String    @default("POST")
  credits      Int       @default(1)
  schemaJson   Json?
  category     String    @default("utility")
  ownerAgentId String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  author       String?
  deprecated   Boolean?
  homepage     String?
  minPlan      ToolPlan?
  tags         String[]  @default([])
  version      String?
}

model ApiRequest {
  id            String   @id @default(cuid())
  agentId       String
  agent         Agent    @relation(fields: [agentId], references: [id])
  toolName      String
  creditsUsed   Int
  status        String   @default("SUCCESS")  // SUCCESS | ERROR | RATE_LIMITED
  responseMs    Int?
  callerType    String?  // ai-agent | sdk | script | human | unknown
  callerName    String?  // claude-desktop | cursor | openai-sdk | python | etc.
  callerVersion String?  // version string if detectable
  createdAt     DateTime @default(now())

  @@index([agentId])
  @@index([toolName])
  @@index([callerName])
  @@index([createdAt])
}

model Purchase {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id])
  stripeId  String   @unique
  credits   Int
  amountCents Int
  status    String   @default("pending")  // pending | completed | refunded
  createdAt DateTime @default(now())

  @@index([agentId])
}

model DailyUsage {
  id        String   @id @default(cuid())
  date      String   // YYYY-MM-DD
  toolName  String
  callCount Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([date, toolName])
  @@index([date])
}

model OAuthClient {
  id                      String   @id @default(cuid())
  clientId                String   @unique
  clientSecret            String?
  name                    String
  redirectUris            String[]
  grantTypes              String[] @default(["authorization_code", "refresh_token"])
  tokenEndpointAuthMethod String   @default("none") @map("token_endpoint_auth_method")
  isPublic                Boolean  @default(true)
  createdAt               DateTime @default(now())
}

model OAuthAuthCode {
  id                  String   @id @default(cuid())
  code                String   @unique
  clientId            String
  agentId             String
  scope               String
  redirectUri         String
  codeChallenge       String?  @map("code_challenge")
  codeChallengeMethod String?  @map("code_challenge_method")
  expiresAt           DateTime
  used                Boolean  @default(false)
  createdAt           DateTime @default(now())

  @@index([code])
  @@index([expiresAt])
}

model OAuthToken {
  id           String   @id @default(cuid())
  accessToken  String   @unique
  refreshToken String   @unique
  clientId     String
  agentId      String
  scope        String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([accessToken])
  @@index([refreshToken])
  @@index([agentId])
}

model X402Payment {
  id          String   @id @default(cuid())
  agentId     String?
  toolName    String
  amountUsdc  String
  txHash      String?
  network     String   @default("base")
  status      String   @default("settled")
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([txHash])
  @@index([toolName])
  @@index([agentId])
}

// ─── Facilitator-as-a-Service ─────────────────────────────────────────────────
// API providers register with Arch Tools to use us as their x402 facilitator.
// We verify payments, settle on-chain, and take a small fee.

model FacilitatorProvider {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  apiKey          String   @unique @map("api_key")       // Provider's facilitator API key
  apiKeyHash      String?  @map("api_key_hash")           // bcrypt hash for secure comparison
  walletAddress   String   @map("wallet_address")         // Provider's wallet for settlement
  webhookUrl      String?  @map("webhook_url")            // Optional webhook for payment events
  feePercent      Float    @default(1.0)                   // Arch Tools fee (% of each tx)
  networks        String[] @default(["eip155:8453"])       // Supported networks
  endpoints       Json?                                     // Provider's registered endpoints + pricing
  active          Boolean  @default(true)
  totalPayments   Int      @default(0) @map("total_payments")
  totalRevenue    Float    @default(0) @map("total_revenue")     // Total USDC settled for provider
  totalFees       Float    @default(0) @map("total_fees")        // Total fees collected by Arch Tools
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  payments        FacilitatorPayment[]

  @@index([apiKey])
  @@index([email])
}

model FacilitatorPayment {
  id              String   @id @default(cuid())
  providerId      String   @map("provider_id")
  provider        FacilitatorProvider @relation(fields: [providerId], references: [id])
  paymentPayload  String   @map("payment_payload") @db.Text  // Base64-encoded x402 payment
  resource        String                                        // The resource URL being paid for
  amount          String                                        // Amount in token atomic units
  token           String   @default("USDC")                     // Token symbol
  network         String   @default("eip155:8453")              // Chain ID
  payerAddress    String?  @map("payer_address")                // Extracted from payment payload
  txHash          String?  @map("tx_hash")                      // On-chain settlement tx hash
  feeAmount       String?  @map("fee_amount")                   // Fee charged by Arch Tools
  status          String   @default("pending")                   // pending | verified | settled | failed
  verifiedAt      DateTime? @map("verified_at")
  settledAt       DateTime? @map("settled_at")
  errorMessage    String?  @map("error_message")
  createdAt       DateTime @default(now())

  @@index([providerId])
  @@index([status])
  @@index([txHash])
  @@index([createdAt])
}
