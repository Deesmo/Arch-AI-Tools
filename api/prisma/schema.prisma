// This is your Prisma schema file

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agent {
  id           String       @id @default(cuid())
  apiKeyPrefix String?      @map("api_key_prefix") @db.VarChar(12)  // first 12 chars — lookup index
  apiKeyHash   String?      @map("api_key_hash")                     // bcrypt hash — the ONLY stored form of the key
  email        String       @unique
  name         String?
  passwordHash      String?      @map("password_hash")
  resetToken        String?      @map("reset_token")
  resetTokenExpiry  DateTime?    @map("reset_token_expiry")
  credits      Int          @default(0)
  tier         String       @default("free")
  totalCalls   Int          @default(0)
  lastSeenAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // ─── Agent Identity (KYA — Know Your Agent) ──────────────────────────────
  description     String?                          // what this agent does
  walletAddress   String?      @map("wallet_address")  // primary wallet for x402 payments
  callbackUrl     String?      @map("callback_url")    // webhook for async notifications
  reputationScore Int          @default(50) @map("reputation_score")  // 0-100
  badge           String       @default("none")    // none | bronze | silver | gold | diamond
  errorCount      Int          @default(0) @map("error_count")
  successCount    Int          @default(0) @map("success_count")
  totalSpentUsdc  Float        @default(0) @map("total_spent_usdc")
  isPublic        Boolean      @default(true) @map("is_public")  // show on leaderboard/profile

  // ─── Email verification gate (credits activate on verify) ──────────────────
  emailVerified     Boolean    @default(false) @map("email_verified")
  verifyToken       String?    @map("verify_token")
  verifyTokenExpiry DateTime?  @map("verify_token_expiry")
  pendingCredits    Int        @default(0) @map("pending_credits")

  // back-references — required for Prisma v5 relations
  apiRequests  ApiRequest[]
  purchases    Purchase[]

  @@index([apiKeyPrefix])
}

// Atomic free-grant guard: one row per normalized email identity. The UNIQUE
// constraint makes free-credit eligibility a DB-level decision (no TOCTOU).
// Starts empty — populated going forward; existing Agent rows are untouched.
model SignupIdentity {
  id              String   @id @default(cuid())
  normalizedEmail String   @unique @map("normalized_email")
  createdAt       DateTime @default(now()) @map("created_at")
}

enum ToolPlan {
  free
  starter
  pro
  business
}

model Tool {
  id           String    @id @default(cuid())
  name         String    @unique
  description  String
  endpoint     String
  method       String    @default("POST")
  credits      Int       @default(1)
  schemaJson   Json?
  category     String    @default("utility")
  ownerAgentId String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  author       String?
  deprecated   Boolean?
  homepage     String?
  minPlan      ToolPlan?
  tags         String[]  @default([])
  version      String?
}

model ApiRequest {
  id            String   @id @default(cuid())
  agentId       String
  agent         Agent    @relation(fields: [agentId], references: [id])
  toolName      String
  creditsUsed   Int
  status        String   @default("SUCCESS")  // SUCCESS | ERROR | RATE_LIMITED
  statusCode    Int?
  responseMs    Int?
  callerType    String?  // ai-agent | sdk | script | human | unknown
  callerName    String?  // claude-desktop | cursor | openai-sdk | python | etc.
  callerVersion String?  // version string if detectable
  createdAt     DateTime @default(now())

  @@index([agentId])
  @@index([toolName])
  @@index([callerName])
  @@index([createdAt])
}

model Purchase {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id])
  stripeId  String   @unique
  // Stripe PaymentIntent id for this purchase — the ONLY reliable link from a
  // charge.refunded / charge.dispute.created event (which carry a Charge +
  // payment_intent, never the checkout-session id we key `stripeId` on) back
  // to the granted credits. Populated at grant time; nullable for legacy rows.
  paymentIntentId String? @map("payment_intent_id")
  credits   Int
  amountCents Int
  status    String   @default("pending")  // pending | completed | refunded | disputed
  clawedBackAt DateTime? @map("clawed_back_at")  // set when credits reversed (refund/dispute)
  createdAt DateTime @default(now())

  @@index([agentId])
  @@index([paymentIntentId])
}

// Idempotency guard for credit clawbacks. One row per Stripe reversal event
// object id (refund / dispute / failed-invoice id). The UNIQUE constraint makes
// "have we already processed this reversal?" a DB-level decision (no TOCTOU) —
// a redelivered webhook loses the INSERT and cannot double-decrement. Mirrors
// the SignupIdentity guard pattern. Starts empty; populated going forward.
model Clawback {
  id        String   @id @default(cuid())
  eventId   String   @unique @map("event_id")  // Stripe refund/dispute/invoice id
  kind      String                              // refund | dispute | payment_failed
  agentId   String?  @map("agent_id")
  purchaseStripeId String? @map("purchase_stripe_id")
  credits   Int      @default(0)                // credits actually clawed back
  createdAt DateTime @default(now()) @map("created_at")

  @@index([agentId])
}

model DailyUsage {
  id        String   @id @default(cuid())
  date      String   // YYYY-MM-DD
  toolName  String
  callCount Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([date, toolName])
  @@index([date])
}

model OAuthClient {
  id                      String   @id @default(cuid())
  clientId                String   @unique
  clientSecret            String?
  name                    String
  redirectUris            String[]
  grantTypes              String[] @default(["authorization_code", "refresh_token"])
  tokenEndpointAuthMethod String   @default("none") @map("token_endpoint_auth_method")
  isPublic                Boolean  @default(true)
  createdAt               DateTime @default(now())
}

model OAuthAuthCode {
  id                  String   @id @default(cuid())
  code                String   @unique
  clientId            String
  agentId             String
  scope               String
  redirectUri         String
  codeChallenge       String?  @map("code_challenge")
  codeChallengeMethod String?  @map("code_challenge_method")
  expiresAt           DateTime
  used                Boolean  @default(false)
  createdAt           DateTime @default(now())

  @@index([code])
  @@index([expiresAt])
}

model OAuthToken {
  id           String   @id @default(cuid())
  accessToken  String   @unique
  refreshToken String   @unique
  clientId     String
  agentId      String
  scope        String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([accessToken])
  @@index([refreshToken])
  @@index([agentId])
}

model X402Payment {
  id          String   @id @default(cuid())
  agentId     String?
  toolName    String
  amountUsdc  String
  txHash      String?
  network     String   @default("base")
  status      String   @default("settled")
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([txHash])
  @@index([toolName])
  @@index([agentId])
}

// ─── Facilitator-as-a-Service ─────────────────────────────────────────────────
// API providers register with Arch Tools to use us as their x402 facilitator.
// We verify payments, settle on-chain, and take a small fee.

model FacilitatorProvider {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  apiKeyHash      String?  @map("api_key_hash")           // bcrypt hash — the ONLY stored form of the key
  walletAddress   String   @map("wallet_address")         // Provider's wallet for settlement
  webhookUrl      String?  @map("webhook_url")            // Optional webhook for payment events
  feePercent      Float    @default(1.0)                   // Arch Tools fee (% of each tx)
  networks        String[] @default(["eip155:8453"])       // Supported networks
  endpoints       Json?                                     // Provider's registered endpoints + pricing
  active          Boolean  @default(true)
  totalPayments   Int      @default(0) @map("total_payments")
  totalRevenue    Float    @default(0) @map("total_revenue")     // Total USDC settled for provider
  totalFees       Float    @default(0) @map("total_fees")        // Total fees collected by Arch Tools
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  payments        FacilitatorPayment[]

  @@index([email])
}

model FacilitatorPayment {
  id              String   @id @default(cuid())
  providerId      String   @map("provider_id")
  provider        FacilitatorProvider @relation(fields: [providerId], references: [id])
  paymentPayload  String   @map("payment_payload") @db.Text  // Base64-encoded x402 payment
  resource        String                                        // The resource URL being paid for
  amount          String                                        // Amount in token atomic units
  token           String   @default("USDC")                     // Token symbol
  network         String   @default("eip155:8453")              // Chain ID
  payerAddress    String?  @map("payer_address")                // Extracted from payment payload
  txHash          String?  @map("tx_hash")                      // On-chain settlement tx hash
  feeAmount       String?  @map("fee_amount")                   // Fee charged by Arch Tools
  status          String   @default("pending")                   // pending | verified | settled | failed
  verifiedAt      DateTime? @map("verified_at")
  settledAt       DateTime? @map("settled_at")
  errorMessage    String?  @map("error_message")
  createdAt       DateTime @default(now())

  @@index([providerId])
  @@index([status])
  @@index([txHash])
  @@index([createdAt])
}

// ─── Webhooks ─────────────────────────────────────────────────────────────────
// Customers register webhook URLs to receive event notifications (payment.received, etc.)

model Webhook {
  id          String   @id @default(cuid())
  agentId     String   @map("agent_id")
  url         String                              // HTTPS endpoint to POST events to
  secret      String                              // HMAC-SHA256 signing secret
  events      String[]                            // subscribed event types
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deliveries  WebhookDelivery[]

  @@index([agentId])
  @@index([active])
}

model WebhookDelivery {
  id          String   @id @default(cuid())
  webhookId   String   @map("webhook_id")
  webhook     Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event       String                              // e.g. payment.received
  payload     Json                                // full event payload sent
  status      String   @default("pending")        // pending | delivered | failed
  httpStatus  Int?     @map("http_status")        // response status code
  attempts    Int      @default(0)
  lastError   String?  @map("last_error")
  deliveredAt DateTime? @map("delivered_at")
  createdAt   DateTime @default(now())

  @@index([webhookId])
  @@index([event])
  @@index([status])
  @@index([createdAt])
}

// ─── Facilitator Fee Records ──────────────────────────────────────────────────
// Granular per-settlement fee tracking for the revenue dashboard

model FacilitatorFeeRecord {
  id              String   @id @default(cuid())
  providerId      String   @map("provider_id")
  paymentId       String   @map("payment_id")
  settlementAmount String  @map("settlement_amount")       // Total USDC settled (atomic)
  feeAmount       String   @map("fee_amount")              // Fee deducted (atomic)
  feePercent      Float    @map("fee_percent")             // Fee % at time of settlement
  providerPayout  String   @map("provider_payout")         // Amount forwarded to provider (atomic)
  network         String   @default("eip155:8453")
  date            String                                    // YYYY-MM-DD for daily rollup
  createdAt       DateTime @default(now())

  @@index([providerId])
  @@index([date])
  @@index([createdAt])
}

// ─── Referrals ────────────────────────────────────────────────────────────────
// Track referral codes and rewards between users

model Referral {
  id             String   @id @default(cuid())
  referrerId     String   @map("referrer_id")       // Agent who shared the code
  referredId     String?  @map("referred_id")        // Agent who signed up with the code
  code           String   @unique                     // e.g. "ARCH-abc123"
  status         String   @default("pending")         // pending | completed | expired
  rewardCredits  Int      @default(500) @map("reward_credits")
  createdAt      DateTime @default(now())
  completedAt    DateTime? @map("completed_at")

  @@index([referrerId])
  @@index([referredId])
  @@index([code])
}

// ─── Directory Premium Listings ───────────────────────────────────────────────
// Premium directory listing upgrades (featured / verified tiers)

model DirectoryListing {
  id              String   @id @default(cuid())
  serviceId       String   @map("service_id")              // References x402-directory.json service ID
  serviceName     String   @map("service_name")
  contactEmail    String   @map("contact_email")
  tier            String   @default("free")                 // free | verified | featured
  monthlyPrice    Float    @default(0) @map("monthly_price") // USD per month
  status          String   @default("pending")              // pending | active | expired | rejected
  approvedBy      String?  @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  expiresAt       DateTime? @map("expires_at")
  stripeSubId     String?  @map("stripe_sub_id")           // Stripe subscription (future)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([serviceId, tier])
  @@index([serviceId])
  @@index([tier])
  @@index([status])
}

// ─── Audit Log (GDPR/Compliance) ─────────────────────────────────────────────
// Tracks all significant user actions for compliance and debugging

model AuditLog {
  id          String   @id @default(cuid())
  agentId     String?  @map("agent_id")     // null for anonymous actions
  action      String                         // e.g. "signup", "login", "x402_payment", "api_call"
  resource    String?                        // e.g. tool name, endpoint
  ip          String?                        // Anonymized IP (last octet zeroed for GDPR)
  userAgent   String?  @map("user_agent")
  status      String   @default("success")  // success | failure
  meta        Json?                          // Additional context (never store sensitive data)
  createdAt   DateTime @default(now())

  @@index([agentId])
  @@index([action])
  @@index([createdAt])
}
