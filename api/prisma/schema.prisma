// This is your Prisma schema file

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agent {
  id           String       @id @default(cuid())
  apiKey       String       @unique @map("api_key")
  email        String       @unique
  name         String?
  credits      Int          @default(0)
  tier         String       @default("free")
  totalCalls   Int          @default(0)
  lastSeenAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  // back-references — required for Prisma v5 relations
  apiRequests  ApiRequest[]
  purchases    Purchase[]
}

model Tool {
  id          String  @id @default(cuid())
  name        String  @unique
  description String
  category    String
  credits     Int
  schemaJson  Json?
  enabled     Boolean @default(true)
}

model ApiRequest {
  id            String   @id @default(cuid())
  agentId       String
  agent         Agent    @relation(fields: [agentId], references: [id])
  toolName      String
  creditsUsed   Int
  status        String   @default("SUCCESS")  // SUCCESS | ERROR | RATE_LIMITED
  responseMs    Int?
  callerType    String?  // ai-agent | sdk | script | human | unknown
  callerName    String?  // claude-desktop | cursor | openai-sdk | python | etc.
  callerVersion String?  // version string if detectable
  createdAt     DateTime @default(now())

  @@index([agentId])
  @@index([toolName])
  @@index([callerName])
  @@index([createdAt])
}

model Purchase {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id])
  stripeId  String   @unique
  credits   Int
  amountCents Int
  status    String   @default("pending")  // pending | completed | refunded
  createdAt DateTime @default(now())

  @@index([agentId])
}

model DailyUsage {
  id        String   @id @default(cuid())
  date      String   // YYYY-MM-DD
  toolName  String
  callCount Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([date, toolName])
  @@index([date])
}

model OAuthClient {
  id           String   @id @default(cuid())
  clientId     String   @unique
  clientSecret String
  name         String
  redirectUris String[]
  createdAt    DateTime @default(now())
}

model OAuthAuthCode {
  id          String   @id @default(cuid())
  code        String   @unique
  clientId    String
  agentId     String
  scope       String
  redirectUri String
  expiresAt   DateTime
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([code])
  @@index([expiresAt])
}

model OAuthToken {
  id           String   @id @default(cuid())
  accessToken  String   @unique
  refreshToken String   @unique
  clientId     String
  agentId      String
  scope        String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([accessToken])
  @@index([refreshToken])
  @@index([agentId])
}

model X402Payment {
  id          String   @id @default(cuid())
  agentId     String?
  toolName    String
  amountUsdc  String
  txHash      String?
  network     String   @default("base")
  status      String   @default("settled")
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
