{
  "name": "arch-ai-tools",
  "version": "1.6.0",
  "description": "Arch Tools — 30 production-ready API tools for developers and AI agents",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "dev": "TS_NODE_TRANSPILE_ONLY=1 node --watch --loader ts-node/esm --env-file-if-exists=.env src/index.ts",
    "seed": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm --env-file-if-exists=.env src/seed.ts",
    "generate": "prisma generate",
    "db:push": "prisma db push --accept-data-loss",
    "refresh-credits": "node dist/cron/refreshCredits.js",
    "demo-topoff": "node dist/cron/demoTopoff.js",
    "db:cleanup": "node dist/cron/dbCleanup.js",
    "npm:audit": "npm audit --json > /tmp/audit.json && echo \"Audit complete\"",
    "test": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm tests/wallet-provisioning.test.js && node --loader ts-node/esm tests/ssrf.test.js && node tests/integration.test.js && node tests/pages.test.js",
    "test:integration": "node tests/integration.test.js",
    "test:pages": "node tests/pages.test.js",
    "test:rate-limit": "node tests/global-rate-limit.test.js",
    "postinstall": "node -e \"const fs=require('fs'); const p='node_modules/@coinbase/cdp-sdk/node_modules/jose'; try{ fs.rmSync(p,{recursive:true,force:true}); } catch(e){}\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@coinbase/cdp-sdk": "^1.45.0",
    "@coinbase/x402": "^2.1.0",
    "@mendable/firecrawl-js": "^4.15.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.42.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@x402/core": "^2.7.0",
    "@x402/evm": "^2.7.0",
    "@x402/express": "^2.7.0",
    "@x402/extensions": "^2.7.0",
    "@x402/svm": "^2.9.0",
    "ajv": "^8.18.0",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "diff": "^8.0.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "fast-xml-parser": "^5.5.7",
    "form-data": "^4.0.6",
    "franc": "^6.2.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "jose": "^5.10.0",
    "js-yaml": "^4.2.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.11.18",
    "lru-cache": "^11.0.2",
    "marked": "^15.0.6",
    "morgan": "^1.10.0",
    "node-fetch": "^2.7.0",
    "posthog-node": "^5.28.2",
    "qrcode": "^1.5.4",
    "resend": "^4.1.2",
    "slugify": "^1.6.6",
    "stripe": "^17.4.0",
    "undici": "^7.28.0",
    "utf-8-validate": "^5.0.10",
    "uuid": "^11.1.1",
    "viem": "^2.47.10",
    "xml2js": "^0.6.2",
    "xmlbuilder2": "^4.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/debug": "^4.1.13",
    "@types/diff": "^7.0.0",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.24",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/trusted-types": "^2.0.7",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@types/xml2js": "^0.4.14",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "@coinbase/cdp-sdk": {
      "jose": "5.10.0"
    },
    "ws": "8.21.0",
    "@opentelemetry/core": "2.8.0",
    "ethjs-unit": {
      "bn.js": "4.12.3"
    },
    "number-to-bn": {
      "bn.js": "4.12.3"
    },
    "uuid": "$uuid"
  }
}
