{
  "name": "arch-ai-tools",
  "version": "1.5.0",
  "description": "Arch Tools — 30 production-ready API tools for developers and AI agents",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only api/src/index.ts",
    "seed": "ts-node --transpile-only api/src/seed.ts",
    "generate": "prisma generate",
    "db:push": "prisma db push --accept-data-loss"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@prisma/client": "^5.22.0",
    "ajv": "^8.18.0",
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "diff": "^7.0.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "fast-xml-parser": "^5.4.2",
    "franc": "^6.2.0",
    "js-yaml": "^4.1.0",
    "libphonenumber-js": "^1.11.18",
    "lru-cache": "^11.0.2",
    "marked": "^15.0.6",
    "morgan": "^1.10.0",
    "qrcode": "^1.5.4",
    "resend": "^4.1.2",
    "slugify": "^1.6.6",
    "stripe": "^17.4.0",
    "uuid": "^11.0.5",
    "xml2js": "^0.6.2",
    "xmlbuilder2": "^3.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/diff": "^7.0.0",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^10.0.0",
    "@types/xml2js": "^0.4.14",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
