{
  "name": "@deesmo/arch-tools-mcp",
  "version": "2.0.0",
  "mcpName": "io.github.deesmo/arch-tools",
  "description": "MCP server for Arch Tools — 64 production-ready API tools for AI agents. Web scraping, AI generation (Claude/GPT-4/Grok/Gemini), crypto data, OCR, image generation (DALL-E 3), audio transcription, text-to-speech, email, domain check, and more. Supports USDC payments via x402.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "arch-tools-mcp": "dist/index.js"
  },
  "keywords": [
    "mcp",
    "ai-agents",
    "api",
    "tools",
    "x402",
    "usdc",
    "web-scraping",
    "ai-generation",
    "crypto"
  ],
  "author": "MCMetaverse LLC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Deesmo/Arch-AI-Tools.git"
  },
  "homepage": "https://archtools.dev",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:sse": "MCP_TRANSPORT=sse node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "node-fetch": "^3.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.11",
    "esbuild": "^0.28.1",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "express-rate-limit": "8.5.2",
    "fast-uri": "3.1.2",
    "hono": "4.12.25",
    "@hono/node-server": "1.19.13",
    "ip-address": "10.2.0",
    "qs": "6.15.2",
    "express": {
      "path-to-regexp": "0.1.13"
    },
    "router": {
      "path-to-regexp": "8.4.2"
    },
    "esbuild": "$esbuild"
  }
}
